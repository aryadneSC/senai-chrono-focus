<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextStyle" />
    <style name="ButtonStyle" />

    <style name="TextStyle.Base">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@color/color_body</item>
    </style>

    <style name="TextStyle.Title">
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">@color/color_title</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextStyle.BigTitle">
        <item name="android:textSize">40sp</item>
        <item name="android:textColor">@color/color_title</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextStyle.Subtitle">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/color_body</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextStyle.Timer">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/color_title</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextStyle.Body">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="ButtonStyle.Primary">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:backgroundTint">@color/color_button_primary</item>
        <item name="android:textColor">@color/color_button_primary_text</item>
    </style>

    <style name="ButtonStyle.Secondary">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:backgroundTint">@color/color_button_secondary</item>
        <item name="android:textColor">@color/color_button_secondary_text</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_border</item>
    </style>

</resources>