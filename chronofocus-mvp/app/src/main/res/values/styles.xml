<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextStyle" />
    <style name="ButtonStyle" />
    <style name="Content" />

    <style name="TextStyle.Title">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextStyle.BigTitle">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextStyle.Subtitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextStyle.Timer">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextStyle.Body">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ButtonStyle.Primary">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

        <style name="ButtonStyle.PrimaryTinyCorner">
            <item name="android:fontFamily">sans-serif-condensed</item>
            <item name="android:textSize">16sp</item>
            <item name="android:textAllCaps">true</item>
            <item name="android:letterSpacing">0.05</item>
            <item name="cornerRadius">8dp</item>
            <item name="android:backgroundTint">?attr/colorPrimary</item>
            <item name="android:textColor">?attr/colorOnPrimary</item>
        </style>

        <style name="ButtonStyle.Secondary">
            <item name="android:fontFamily">sans-serif-condensed</item>
            <item name="android:textSize">16sp</item>
            <item name="android:textAllCaps">true</item>
            <item name="android:letterSpacing">0.05</item>
            <item name="android:backgroundTint">?attr/colorSurface</item>
            <item name="android:textColor">?attr/colorPrimary</item>
            <item name="strokeWidth">1dp</item>
            <item name="strokeColor">?attr/colorOutline</item>
        </style>
</resources>